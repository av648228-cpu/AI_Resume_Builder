# Generate a private value for production; do not commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret

# Default local database. For a persistent production volume, set an absolute SQLite path.
DATABASE_URL=sqlite:///resume_builder.db
UPLOAD_FOLDER=./uploads

# Optional. Leave blank to use rule-based import and disable AI description improvement.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional platform port; Render/Railway usually set PORT automatically.
PORT=5000
